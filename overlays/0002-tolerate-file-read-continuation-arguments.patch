diff --git a/packages/agent-tools/test/file-read-continuation.test.ts b/packages/agent-tools/test/file-read-continuation.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/agent-tools/test/file-read-continuation.test.ts
@@ -0,0 +1,24 @@
+import { describe, expect, it } from 'vitest';
+import { createToolRegistry } from '../src';
+
+describe('file.read continuation input normalization', () => {
+  it('accepts numeric strings and lets offset override repeated line-range fields', () => {
+    const registry = createToolRegistry();
+    const parsed = registry.parse({
+      id: 'file-read-continuation',
+      name: 'file.read',
+      provider: 'test',
+      arguments: {
+        path: 'README.md',
+        startLine: '2',
+        endLine: '3',
+        offset: '5',
+        maxCharacters: '100'
+      }
+    });
+
+    expect(parsed.input).toMatchObject({ path: 'README.md', offset: 5, maxCharacters: 100 });
+    expect(parsed.input.startLine).toBeUndefined();
+    expect(parsed.input.endLine).toBeUndefined();
+  });
+});
