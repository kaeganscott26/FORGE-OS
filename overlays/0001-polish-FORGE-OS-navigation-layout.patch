From: North3rnLight3r <kaeganscott26@gmail.com>
Date: Tue, 11 Aug 2026 09:44:00 -0500
Subject: [PATCH] polish FORGE OS navigation layout

---
 apps/desktop/src/renderer/src/App.tsx         |  2 +-
 .../src/renderer/src/styles/global.css        | 21 +++++++++++++++----
 2 files changed, 18 insertions(+), 5 deletions(-)

diff --git a/apps/desktop/src/renderer/src/App.tsx b/apps/desktop/src/renderer/src/App.tsx
index 4e006f9..b200e57 100644
--- a/apps/desktop/src/renderer/src/App.tsx
+++ b/apps/desktop/src/renderer/src/App.tsx
@@ -205,7 +205,7 @@ export default function App(): JSX.Element {
 
   return <main className="app-shell">
     <ForgeOsShell />
-    <header className="app-header"><div className="brand"><span>F</span> FORGE <small>v{updateStatus?.currentVersion ?? '2.3.0-beta.1-dev'} · {workspace?.name ?? 'No workspace'}</small></div><div className="toolbar">{updateStatus?.state === 'downloaded' ? <button className="update-ready" onClick={installUpdate}>Restart to update</button> : <button onClick={checkForUpdates} disabled={checkingUpdate || ['checking', 'available', 'downloading'].includes(updateStatus?.state ?? '')}>{updateStatus?.state === 'available' ? `Preparing v${updateStatus.availableVersion}…` : updateStatus?.state === 'downloading' ? 'Downloading update…' : checkingUpdate || updateStatus?.state === 'checking' ? 'Checking…' : 'Check for updates'}</button>}<button className={browserOpen ? 'active-tab' : ''} onClick={() => setBrowserOpen((open) => !open)}>Browser</button><button onClick={openReleases}>Releases</button><button onClick={() => setSettingsOpen('github')}>GitHub</button><button onClick={() => setSettingsOpen('api')}>Settings</button><button title="Open workspace (⌘/Ctrl+O)" onClick={openWorkspace}>Open workspace</button><button disabled={!workspace} onClick={() => void createEntry('file')}>New file</button><button title="Save (⌘/Ctrl+S)" disabled={!active || content === savedContent} onClick={save}>Save</button><button disabled={!selectedNode} className="danger" onClick={deleteActive}>Delete</button></div></header>
+    <header className="app-header"><div className="brand"><span>F</span> FORGE <small>v{updateStatus?.currentVersion ?? '2.3.0-beta.1-dev'} · {workspace?.name ?? 'No workspace'}</small></div><div className="toolbar"><button className={`browser-launcher ${browserOpen ? 'active-tab' : ''}`} aria-pressed={browserOpen} title="Open the private workspace browser" onClick={() => setBrowserOpen((open) => !open)}>Browser</button>{updateStatus?.state === 'downloaded' ? <button className="update-ready" onClick={installUpdate}>Restart to update</button> : <button className="toolbar-secondary" onClick={checkForUpdates} disabled={checkingUpdate || ['checking', 'available', 'downloading'].includes(updateStatus?.state ?? '')}>{updateStatus?.state === 'available' ? `Preparing v${updateStatus.availableVersion}…` : updateStatus?.state === 'downloading' ? 'Downloading update…' : checkingUpdate || updateStatus?.state === 'checking' ? 'Checking…' : 'Check for updates'}</button>}<button className="toolbar-secondary" onClick={openReleases}>Releases</button><button className="toolbar-secondary" onClick={() => setSettingsOpen('github')}>GitHub</button><button onClick={() => setSettingsOpen('api')}>Settings</button><button title="Open workspace (⌘/Ctrl+O)" onClick={openWorkspace}>Open workspace</button><button disabled={!workspace} onClick={() => void createEntry('file')}>New file</button><button title="Save (⌘/Ctrl+S)" disabled={!active || content === savedContent} onClick={save}>Save</button><button disabled={!selectedNode} className="danger" onClick={deleteActive}>Delete</button></div></header>
     {settingsOpen && <SettingsModal initialSection={settingsOpen} onClose={() => setSettingsOpen(null)} />}
     {error && <div className="notice"><span>{error}</span><button onClick={() => setError(null)}>×</button></div>}
     {!workspace ? <section className="welcome"><div><p className="eyebrow">LOCAL-FIRST DEVELOPMENT WORKSPACE</p><h1>Think in files.<br />Build with context.</h1><p>FORGE keeps your notes, source code, Git history, conversations, and durable project memory in one private desktop workspace.</p><button className="primary" onClick={openWorkspace}>Open a project folder</button></div></section> : <section className="workspace-grid" style={gridStyle}>
diff --git a/apps/desktop/src/renderer/src/styles/global.css b/apps/desktop/src/renderer/src/styles/global.css
index d9c820e..c5e6021 100644
--- a/apps/desktop/src/renderer/src/styles/global.css
+++ b/apps/desktop/src/renderer/src/styles/global.css
@@ -8,9 +8,13 @@ button { cursor: pointer; border: 0; border-radius: 5px; color: #dce3eb; backgro
 button:hover { background: #35404c; }
 button:disabled { opacity: .42; cursor: default; }
 .app-shell { height: 100vh; min-height: 0; background: radial-gradient(circle at 50% -30%, #1d2e38, #0b0d10 55%); }
-.forge-os-bar { position: fixed; z-index: 90; left: 50%; top: 8px; transform: translateX(-50%); width: min(720px, calc(100vw - 330px)); height: 36px; display: flex; align-items: center; gap: 5px; padding: 4px 6px; border: 1px solid #34433b; border-radius: 9px; background: rgba(12,18,20,.96); box-shadow: 0 8px 30px rgba(0,0,0,.35); }
-.forge-os-bar button { padding: 5px 9px; background: transparent; font-size: 10px; }.forge-os-bar button:hover { background: #28362e; }.forge-os-bar time { color: #bec9c2; font-size: 10px; white-space: nowrap; }.forge-os-spacer { flex: 1; }
-.forge-os-popover { position: fixed; z-index: 100; top: 49px; max-height: calc(100vh - 65px); overflow: auto; border: 1px solid #3b4c42; border-radius: 9px; background: #10181a; box-shadow: 0 18px 55px rgba(0,0,0,.65); }.forge-os-popover header { display: flex; justify-content: space-between; padding: 12px; border-bottom: 1px solid #293831; }.forge-os-popover header span { color: #82948a; font-size: 10px; }
+.app-shell:has(> .forge-os-bar) { display: grid; grid-template-rows: 40px 52px minmax(0, 1fr); }
+.app-shell:has(> .forge-os-bar) > .app-header { grid-row: 2; }
+.app-shell:has(> .forge-os-bar) > .workspace-grid, .app-shell:has(> .forge-os-bar) > .welcome { grid-row: 3; height: 100%; min-height: 0; }
+.forge-os-bar { position: relative; z-index: 90; grid-row: 1; width: 100%; height: 40px; display: flex; align-items: center; gap: 4px; padding: 4px 12px; border-bottom: 1px solid #2d3b34; background: linear-gradient(180deg, #141c1b, #0e1516); box-shadow: 0 1px 0 rgba(255,255,255,.025); }
+.forge-os-bar::before { content: 'FORGE OS'; margin-right: 6px; color: #b8ff4d; font-size: 9px; font-weight: 800; letter-spacing: .14em; }
+.forge-os-bar button { padding: 5px 9px; background: transparent; color: #c9d4ce; font-size: 10px; }.forge-os-bar button:hover { background: #28362e; color: #eff7f1; }.forge-os-bar time { color: #93a29a; font-size: 10px; white-space: nowrap; }.forge-os-spacer { flex: 1; }
+.forge-os-popover { position: fixed; z-index: 100; top: 42px; max-height: calc(100vh - 54px); overflow: auto; border: 1px solid #3b4c42; border-radius: 9px; background: #10181a; box-shadow: 0 18px 55px rgba(0,0,0,.65); }.forge-os-popover header { display: flex; justify-content: space-between; padding: 12px; border-bottom: 1px solid #293831; }.forge-os-popover header span { color: #82948a; font-size: 10px; }
 .forge-os-applications { left: max(12px, calc(50% - 360px)); width: 330px; }.forge-os-applications > button { display: grid; width: 100%; gap: 3px; padding: 9px 12px; border-radius: 0; background: transparent; text-align: left; }.forge-os-applications > button:hover { background: #213027; }.forge-os-applications small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
 .forge-os-system { right: max(12px, calc(50% - 360px)); width: min(440px, calc(100vw - 24px)); }.forge-os-system dl { display: grid; grid-template-columns: 110px 1fr; gap: 7px 12px; padding: 12px; margin: 0; font-size: 11px; }.forge-os-system dt { color: #7f9188; }.forge-os-system dd { margin: 0; overflow-wrap: anywhere; }.forge-os-system footer { padding: 10px 12px; border-top: 1px solid #293831; color: #71847a; font-size: 9px; line-height: 1.6; }
 .forge-os-session { right: max(12px, calc(50% - 360px)); width: 210px; padding: 6px; }.forge-os-session button { display: block; width: 100%; background: transparent; text-align: left; }.forge-os-session button:hover { background: #27362d; }.forge-os-session p { margin: 7px; color: #819087; font-size: 9px; }.forge-os-error { position: fixed; z-index: 110; top: 55px; left: 50%; transform: translateX(-50%); padding: 8px 10px; background: #4b2028; border-radius: 6px; font-size: 10px; }.forge-os-error button { padding: 0 4px; margin-left: 8px; background: transparent; }
@@ -22,6 +26,10 @@ small, .muted { color: #7d8997; font-weight: 400; letter-spacing: 0; }
 .toolbar { min-width: 0; display: flex; gap: 7px; overflow-x: auto; scrollbar-width: none; }
 .toolbar::-webkit-scrollbar { display: none; }
 .toolbar button { flex: 0 0 auto; white-space: nowrap; }
+.toolbar .browser-launcher { border: 1px solid #46573b; color: #dfffb8; }
+.toolbar .browser-launcher::before { content: '◎'; margin-right: 6px; color: #b8ff4d; }
+.toolbar .browser-launcher.active-tab { background: #b8ff4d; color: #14200d; }
+.toolbar .browser-launcher.active-tab::before { color: #14200d; }
 .danger { color: #ff9a9a; }
 .notice { position: absolute; top: 62px; left: 50%; transform: translateX(-50%); z-index: 5; background: #4b2028; border: 1px solid #a84d57; padding: 10px 12px; border-radius: 6px; display: flex; gap: 18px; }
 .notice button { padding: 0 5px; background: transparent; }
@@ -226,7 +234,7 @@ h3 { font-size: 11px; text-transform: uppercase; color: #8795a5; letter-spacing:
   .workspace-grid { grid-template-columns: minmax(180px, 220px) 5px minmax(0, 1fr); }
   .intelligence-panel, .intelligence-resizer { display: none; }
   .git-panel, .git-resizer { grid-column: 3; }
-  .toolbar button:nth-child(-n+3) { display: none; }
+  .toolbar .toolbar-secondary { display: none; }
 }
 @media (max-width: 760px) {
   .app-header { padding: 0 10px; }
@@ -236,4 +244,9 @@ h3 { font-size: 11px; text-transform: uppercase; color: #8795a5; letter-spacing:
   .editor-area, .git-panel, .git-resizer { grid-column: 1; }
   .git-content { grid-template-columns: minmax(120px, 1fr) minmax(130px, 1fr); }
   .diff { grid-column: 1 / 3; max-height: 120px; }
+  .forge-os-bar::before { display: none; }
+  .forge-os-bar { padding-inline: 7px; }
+  .forge-os-bar button { padding-inline: 7px; }
+  .forge-os-bar time { font-size: 9px; }
+  .toolbar button:not(.browser-launcher):not(:last-child) { display: none; }
 }
