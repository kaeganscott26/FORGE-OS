#!/bin/sh

if [ -d /etc/X11/xinit/xinitrc.d ]; then
  for hook in /etc/X11/xinit/xinitrc.d/*; do
    [ -x "$hook" ] && . "$hook"
  done
  unset hook
fi

export XDG_CURRENT_DESKTOP=FORGE
export XDG_SESSION_DESKTOP=FORGE
export DESKTOP_SESSION=forge
export XDG_SESSION_TYPE=x11
export FORGE_OS_SESSION=1
export FORGE_SHELL_MODE=1
export FORGE_OS_VERSION="$(</etc/forge-os-version)"

printf '[%s] X session active; DISPLAY=%s\n' "$(date --iso-8601=seconds)" "${DISPLAY:-unset}"

# Make the graphical environment available to D-Bus/systemd activated user
# services. Preserve the values established by xinit/PAM; do not synthesize a
# display or bus address here.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE DBUS_SESSION_BUS_ADDRESS FORGE_OS_SESSION FORGE_SHELL_MODE FORGE_OS_VERSION || true
fi

command -v xdg-user-dirs-update >/dev/null 2>&1 && xdg-user-dirs-update
command -v dunst >/dev/null 2>&1 && dunst &
if command -v /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 >/dev/null 2>&1; then
  /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
fi

openbox-session &
openbox_pid=$!
printf '[%s] Openbox started with PID %s\n' "$(date --iso-8601=seconds)" "$openbox_pid"
trap 'kill "$openbox_pid" 2>/dev/null || true' EXIT HUP INT TERM

# Do not exec: launcher failure should shut down X and return to the console.
/usr/local/bin/forge-session
status=$?
printf '[%s] FORGE exited with status %s\n' "$(date --iso-8601=seconds)" "$status"
exit "$status"
