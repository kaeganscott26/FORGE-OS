#!/bin/sh

if [ -d /etc/X11/xinit/xinitrc.d ]; then
  for hook in /etc/X11/xinit/xinitrc.d/*; do
    [ -x "$hook" ] && . "$hook"
  done
  unset hook
fi

export XDG_CURRENT_DESKTOP=FORGE
export XDG_SESSION_DESKTOP=FORGE
export DESKTOP_SESSION=forge
export XDG_SESSION_TYPE=x11
export FORGE_OS_SESSION=1
export FORGE_SHELL_MODE=1
export FORGE_OS_VERSION="$(cat /etc/forge-os-version 2>/dev/null || printf 'unknown')"

if [ -z "${DISPLAY:-}" ]; then
  printf '[%s] ERROR: X client started without DISPLAY\n' "$(date --iso-8601=seconds)" >&2
  exit 71
fi

if [ -n "${FORGE_X_READY_MARKER:-}" ]; then
  : >"$FORGE_X_READY_MARKER"
fi
printf '[%s] X session active; DISPLAY=%s; XDG_RUNTIME_DIR=%s\n' \
  "$(date --iso-8601=seconds)" "$DISPLAY" "${XDG_RUNTIME_DIR:-unset}"

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_RUNTIME_DIR XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE DBUS_SESSION_BUS_ADDRESS FORGE_OS_SESSION FORGE_SHELL_MODE FORGE_OS_VERSION || true
fi

command -v xdg-user-dirs-update >/dev/null 2>&1 && xdg-user-dirs-update
command -v dunst >/dev/null 2>&1 && dunst &
if [ -x /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 ]; then
  /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
fi

if ! command -v openbox-session >/dev/null 2>&1; then
  printf '[%s] ERROR: openbox-session is unavailable\n' "$(date --iso-8601=seconds)" >&2
  exit 72
fi
openbox-session &
openbox_pid=$!
printf '[%s] Openbox started with PID %s\n' "$(date --iso-8601=seconds)" "$openbox_pid"
trap 'kill "$openbox_pid" 2>/dev/null || true' EXIT HUP INT TERM

/usr/local/bin/forge-session
status=$?
printf '[%s] FORGE exited with status %s\n' "$(date --iso-8601=seconds)" "$status"
exit "$status"
