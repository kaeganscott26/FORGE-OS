#!/usr/bin/env bash
set -euo pipefail

if [[ "$EUID" -eq 0 ]]; then
  echo 'FORGE must run as a normal user.' >&2
  exit 77
fi

export XDG_CURRENT_DESKTOP=FORGE
export XDG_SESSION_DESKTOP=FORGE
export DESKTOP_SESSION=forge
export XDG_SESSION_TYPE=x11
export FORGE_OS_SESSION=1
export FORGE_SHELL_MODE=1
export FORGE_OS_VERSION="$(</etc/forge-os-version)"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/forge"
mkdir -p "$state_dir"
exec >>"$state_dir/session.log" 2>&1
printf '\n[%s] authenticated session entered; launching verified xinit client path\n' "$(date --iso-8601=seconds)"

# This is the verified post-authentication runtime path. Keep the wrapper as a
# recovery/session-entry alias, but do not override xinit's server selection or
# inject custom display/VT arguments; the direct command is what successfully
# boots FORGE from tuigreet after credential verification.
exec /usr/bin/xinit /usr/local/libexec/forge-session-client
