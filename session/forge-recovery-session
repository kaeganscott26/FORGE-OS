#!/usr/bin/env bash
set -euo pipefail

[[ "${EUID}" -ne 0 ]] || { echo 'FORGE Recovery must run as a normal user.' >&2; exit 77; }
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=FORGE-Recovery
export XDG_CURRENT_DESKTOP=FORGE
export FORGE_OS_SESSION=1
export FORGE_SHELL_MODE=1
export FORGE_RECOVERY_MODE=1
export QT_QPA_PLATFORM=wayland
export ELECTRON_OZONE_PLATFORM_HINT=wayland
export XDG_CONFIG_DIRS="/etc/xdg${XDG_CONFIG_DIRS:+:$XDG_CONFIG_DIRS}"
export XDG_DATA_DIRS="$HOME/.nix-profile/share:/nix/var/nix/profiles/default/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export FORGE_OS_VERSION="$(cat /etc/forge-os-version 2>/dev/null || printf development)"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/forge"
mkdir -p "$state_dir"
touch "$state_dir/recovery.log"
chmod 600 "$state_dir/recovery.log"
printf '[%s] entering isolated tty2 recovery compositor\n' "$(date --iso-8601=seconds)" >>"$state_dir/recovery.log"
exec dbus-run-session kwin_wayland --xwayland --exit-with-session /usr/local/libexec/forge-recovery-client >>"$state_dir/recovery.log" 2>&1
