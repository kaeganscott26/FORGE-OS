#!/usr/bin/env bash
set -euo pipefail

[[ "${FORGE_RECOVERY_MODE:-0}" == 1 && "${XDG_SESSION_TYPE:-}" == wayland && -n "${WAYLAND_DISPLAY:-}" ]] || { echo 'Recovery client requires the isolated FORGE Wayland recovery session.' >&2; exit 71; }
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XAUTHORITY XDG_RUNTIME_DIR XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE DBUS_SESSION_BUS_ADDRESS FORGE_OS_SESSION FORGE_SHELL_MODE FORGE_RECOVERY_MODE FORGE_OS_VERSION
fi
command -v systemctl >/dev/null 2>&1 && systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XAUTHORITY XDG_RUNTIME_DIR XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE FORGE_OS_SESSION FORGE_SHELL_MODE FORGE_RECOVERY_MODE FORGE_OS_VERSION || true
if [[ -x /usr/lib/polkit-kde-authentication-agent-1 ]]; then /usr/lib/polkit-kde-authentication-agent-1 & fi
exec /usr/local/bin/forge-session
