#!/usr/bin/env bash
set -euo pipefail

[[ "$EUID" -ne 0 ]] || { echo 'Run as the signed-in user; PolicyKit handles activation.' >&2; exit 77; }
target="$(readlink -f /opt/forge/last-known-good 2>/dev/null || true)"
current="$(readlink -f /opt/forge/current 2>/dev/null || true)"
[[ -n "$target" && -d "$target" && -r "$target/.forge-runtime.env" ]] || { echo 'No verified last-known-good runtime is available.' >&2; exit 69; }
[[ "$target" != "$current" ]] || { echo 'The last-known-good runtime is already active.'; exit 0; }
source "$target/.forge-runtime.env"
binary="$target/${FORGE_EXECUTABLE_RELATIVE_PATH:-missing}"
asar="$target/resources/app.asar"
[[ "$(sha256sum "$binary" | awk '{print $1}')" == "${FORGE_EXECUTABLE_SHA256:-}" ]] || { echo 'Rollback executable integrity check failed.' >&2; exit 74; }
[[ "$(sha256sum "$asar" | awk '{print $1}')" == "${FORGE_APP_ASAR_SHA256:-}" ]] || { echo 'Rollback app.asar integrity check failed.' >&2; exit 74; }
pkexec /usr/local/libexec/forge-runtime-rollback-activate "$target" "$current"
echo "Activated last-known-good runtime: $(basename "$target")"
echo "Retained previous current runtime as alternate rollback target: $(basename "$current")"
echo 'Log out and sign in again to enter it. Running rollback again switches back after integrity verification.'
