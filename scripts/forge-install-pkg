#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: forge-install-pkg [--backend arch|apt|kali|nix] PACMAN_ARGS...
       forge-install-pkg --backend apt|kali|nix OPERATION [PACKAGE...]

Arch accepts normal pacman arguments. Read-only queries run directly; mutating
operations cross the explicit PolicyKit boundary. Compatibility backends use
operations: -S, -Syu, -R, -Rns, -Q, -Ss, -Si.
EOF
}

backend=arch
if [[ "${1:-}" == --backend ]]; then [[ $# -ge 3 ]] || { usage >&2; exit 64; }; backend="$2"; shift 2; fi
(( $# > 0 )) || { usage >&2; exit 64; }

case "$backend" in
  arch)
    command -v /usr/bin/pacman >/dev/null || { echo 'The Arch backend is unavailable.' >&2; exit 69; }
    first="$1"
    case "$first" in
      -Q*|-Ss|-Si|-Sl|-Sg|-Sp|--query|--search|--info)
        exec /usr/bin/pacman "$@"
        ;;
      *)
        command -v pkexec >/dev/null || { echo 'pkexec is required for package mutations.' >&2; exit 69; }
        exec pkexec /usr/bin/pacman "$@"
        ;;
    esac
    ;;
  apt|kali|nix)
    operation="$1"; shift
    [[ "$operation" =~ ^-(S|Syu|R|Rns|Q|Ss|Si)$ ]] || { usage >&2; exit 64; }
    if [[ "$backend" == apt || "$backend" == kali ]]; then
      box=forge-apt; [[ "$backend" == kali ]] && box=forge-kali
      distrobox list --no-color 2>/dev/null | grep -q "$box" || { echo "Initialize with: forge-workspace-bootstrap $backend" >&2; exit 69; }
      case "$operation" in
        -S) exec distrobox enter "$box" -- sudo apt-get install -- "$@" ;;
        -Syu) distrobox enter "$box" -- sudo apt-get update; exec distrobox enter "$box" -- sudo apt-get dist-upgrade ;;
        -R|-Rns) exec distrobox enter "$box" -- sudo apt-get remove -- "$@" ;;
        -Q) exec distrobox enter "$box" -- dpkg-query -W "$@" ;;
        -Ss) exec distrobox enter "$box" -- apt-cache search -- "$@" ;;
        -Si) exec distrobox enter "$box" -- apt-cache show -- "$@" ;;
      esac
    else
      command -v nix-env >/dev/null || { echo 'Initialize with: forge-workspace-bootstrap nix' >&2; exit 69; }
      case "$operation" in
        -S) attrs=(); for package in "$@"; do [[ "$package" =~ ^[A-Za-z0-9._+-]+$ ]] || { echo "Invalid Nix attribute: $package" >&2; exit 64; }; attrs+=("nixpkgs.$package"); done; exec nix-env -iA "${attrs[@]}" ;;
        -Syu) nix-channel --update nixpkgs; exec nix-env -u ;;
        -R|-Rns) exec nix-env -e "$@" ;;
        -Q) exec nix-env -q "$@" ;;
        -Ss) exec nix search nixpkgs "$@" ;;
        -Si) exec nix-env -qa --description "$@" ;;
      esac
    fi
    ;;
  *) echo "Unknown backend: $backend" >&2; exit 64 ;;
esac
