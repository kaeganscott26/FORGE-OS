#!/usr/bin/env bash
set -euo pipefail

[[ "$EUID" -eq 0 ]] || { echo 'forge-system-checkpoint must run as root.' >&2; exit 77; }
[[ $# -eq 2 ]] || { echo 'Usage: forge-system-checkpoint FORGE_COMMIT FORGE_OS_COMMIT' >&2; exit 64; }
forge_commit="$1"
os_commit="$2"
[[ "$forge_commit" =~ ^[0-9a-f]{40}$ && "$os_commit" =~ ^[0-9a-f]{40}$ ]] || { echo 'Checkpoint source commits must be full Git SHAs.' >&2; exit 64; }

checkpoint_root=/var/lib/forge-os/checkpoints
checkpoint="$checkpoint_root/previous"
temporary="$checkpoint_root/.previous.new.$$"
old="$checkpoint_root/.previous.old.$$"
cleanup() { rm -rf -- "$temporary" "$old"; }
trap cleanup EXIT HUP INT TERM

install -d -o root -g root -m 0700 "$checkpoint_root"
rm -rf -- "$temporary"
install -d -o root -g root -m 0700 "$temporary/rootfs"

copy_if_present() {
  local path="$1" destination
  [[ -e "$path" || -L "$path" ]] || return 0
  destination="$temporary/rootfs$(dirname "$path")"
  install -d -o root -g root -m 0755 "$destination"
  cp -a -- "$path" "$destination/"
}

# Snapshot only FORGE-owned system integration. User projects, home files,
# package databases, and unrelated system configuration are intentionally out
# of scope.
for path in \
  /etc/greetd/config.toml \
  /etc/greetd/forge-recovery.toml \
  /etc/systemd/system/forge-recovery.service \
  /etc/xdg/kdeglobals \
  /etc/xdg/kwinrc \
  /etc/xdg/reflector/reflector.conf \
  /usr/share/xdg-desktop-portal/forge-portals.conf \
  /etc/forge-os-version \
  /etc/issue; do
  copy_if_present "$path"
done

if [[ -d /usr/share/forge-os ]]; then
  install -d -o root -g root -m 0755 "$temporary/rootfs/usr/share"
  cp -a /usr/share/forge-os "$temporary/rootfs/usr/share/"
fi

for path in /usr/local/bin/forge-* /usr/local/libexec/forge-* /usr/share/applications/forge-*.desktop; do
  [[ -e "$path" || -L "$path" ]] || continue
  copy_if_present "$path"
done
copy_if_present /usr/local/bin/startplasma-wayland

current_runtime="$(readlink -f /opt/forge/current 2>/dev/null || true)"
known_good_runtime="$(readlink -f /opt/forge/last-known-good 2>/dev/null || true)"
[[ "$current_runtime" == /opt/forge/releases/* && -d "$current_runtime" ]] || { echo 'Current FORGE runtime is not an immutable release.' >&2; exit 69; }

cat >"$temporary/metadata.env" <<EOF
FORGE_CHECKPOINT_CREATED=$(date -u +%Y-%m-%dT%H:%M:%SZ)
FORGE_CHECKPOINT_FORGE_COMMIT=$forge_commit
FORGE_CHECKPOINT_OS_COMMIT=$os_commit
FORGE_CHECKPOINT_RUNTIME=$(basename "$current_runtime")
FORGE_CHECKPOINT_PREVIOUS_LKG=$(basename "$known_good_runtime")
EOF
chmod 0600 "$temporary/metadata.env"

(
  cd "$temporary/rootfs"
  find . -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum >"$temporary/SHA256SUMS"
  find . -type l -printf '%p -> %l\n' | LC_ALL=C sort >"$temporary/SYMLINKS"
)
chmod 0600 "$temporary/SHA256SUMS" "$temporary/SYMLINKS"

if [[ -e "$checkpoint" ]]; then mv "$checkpoint" "$old"; fi
mv "$temporary" "$checkpoint"
rm -rf -- "$old"
trap - EXIT HUP INT TERM

echo "Saved verified FORGE-OS pre-update checkpoint: $checkpoint"
