#!/usr/bin/env bash
set -euo pipefail

[[ "$EUID" -eq 0 ]] || { echo 'forge-live-install requires root. Launch it through the FORGE Live Recovery UI or sudo.' >&2; exit 77; }

mode="${1:-}"
bundle="${2:-}"
case "$mode" in
  inspect|install) ;;
  *) echo 'Usage: forge-live-install inspect|install /path/to/bundle.iso|bundle.zip' >&2; exit 64 ;;
esac
[[ -n "$bundle" ]] || { echo 'An ISO or ZIP path is required.' >&2; exit 64; }
bundle="$(readlink -f -- "$bundle")"
[[ -f "$bundle" ]] || { echo "Bundle does not exist: $bundle" >&2; exit 66; }

case "${bundle,,}" in
  *.iso) kind=iso ;;
  *.zip) kind=zip ;;
  *) echo 'Only .iso and .zip recovery/installation bundles are supported.' >&2; exit 65 ;;
esac

stage=/run/forge-live-installer
source_dir="$stage/source"
mounted=false
cleanup() {
  if [[ "$mounted" == true ]] && mountpoint -q "$source_dir"; then
    umount "$source_dir" || true
  fi
  rm -rf -- "$stage"
}
trap cleanup EXIT HUP INT TERM
rm -rf -- "$stage"
install -d -m 0755 "$source_dir"

if [[ "$kind" == iso ]]; then
  command -v mount >/dev/null || { echo 'mount is required to load ISO images.' >&2; exit 69; }
  mount -o loop,ro -- "$bundle" "$source_dir"
  mounted=true
else
  command -v bsdtar >/dev/null || { echo 'bsdtar is required to load ZIP archives.' >&2; exit 69; }
  while IFS= read -r entry; do
    case "$entry" in
      /*|../*|*/../*|*/..) echo "Unsafe archive path rejected: $entry" >&2; exit 65 ;;
    esac
  done < <(bsdtar -tf "$bundle")
  bsdtar -xf "$bundle" -C "$source_dir"
  chmod -R a+rX "$source_dir"
fi

find_installer() {
  local candidate resolved
  for candidate in \
    "$source_dir/forge-install.sh" \
    "$source_dir/install.sh" \
    "$source_dir/scripts/forge-install.sh" \
    "$source_dir/scripts/install.sh" \
    "$source_dir/scripts/install-forge-linux.sh"; do
    [[ -f "$candidate" ]] || continue
    resolved="$(readlink -f -- "$candidate")"
    [[ "$resolved" == "$source_dir"/* ]] || { echo "Installer escapes staged bundle: $candidate" >&2; return 65; }
    printf '%s\n' "$resolved"
    return 0
  done
  return 1
}

installer="$(find_installer || true)"
printf 'Bundle: %s\nType: %s\nSize: %s bytes\n' "$bundle" "$kind" "$(stat -c '%s' "$bundle")"
if [[ -n "$installer" ]]; then
  printf 'Installer: %s\n' "${installer#"$source_dir/"}"
else
  printf 'Installer: none detected\n'
fi

if [[ "$mode" == inspect ]]; then
  if [[ -n "$installer" ]]; then
    echo 'READY: recognized installer entry point found.'
    exit 0
  fi
  echo 'LOADED: the bundle is readable, but no supported installer entry point was found.'
  exit 2
fi

[[ -n "$installer" ]] || {
  echo 'Refusing automatic installation because this bundle has no recognized installer entry point.' >&2
  echo 'Use the sudo recovery shell to inspect or install it manually.' >&2
  exit 65
}
id forge >/dev/null 2>&1 || { echo 'The ephemeral forge live user is missing.' >&2; exit 67; }

printf '\nAbout to run %s from the selected %s bundle.\n' "${installer#"$source_dir/"}" "$kind"
printf 'This installer can modify disks and the installed system. Type INSTALL to continue: '
read -r confirmation
[[ "$confirmation" == INSTALL ]] || { echo 'Installation cancelled.'; exit 130; }

installer_dir="$(dirname "$installer")"
installer_name="$(basename "$installer")"
set +e
runuser -u forge -- env \
  HOME=/home/forge \
  USER=forge \
  LOGNAME=forge \
  PATH=/usr/local/sbin:/usr/local/bin:/usr/bin \
  bash -c 'cd -- "$1" && exec bash "./$2"' bash "$installer_dir" "$installer_name"
status=$?
set -e
exit "$status"
