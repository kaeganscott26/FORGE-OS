#!/usr/bin/env bash
set -euo pipefail

location="${1:-}"
if [[ -z "$location" ]]; then
  location="$(kdialog --title 'FORGE Panel Manager' --menu 'Add a customizable Plasma panel:' top Top bottom Bottom left Left right Right 2>/dev/null || true)"
fi
case "$location" in top|bottom|left|right) ;; '') exit 0 ;; *) echo 'Usage: forge-panel-manager [top|bottom|left|right]' >&2; exit 64 ;; esac

script="var panel = new Panel; panel.location = '$location'; panel.height = 44; panel.addWidget('org.kde.plasma.kickoff'); panel.addWidget('org.kde.plasma.icontasks'); panel.addWidget('org.kde.plasma.systemtray'); panel.addWidget('org.kde.plasma.digitalclock');"
qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$script"
