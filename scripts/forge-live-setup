#!/usr/bin/env bash
set -euo pipefail

[[ "$EUID" -eq 0 ]] || { echo 'forge-live-setup is a system service.' >&2; exit 77; }

is_live=false
if [[ "${FORGE_LIVE_FORCE:-0}" == 1 || -d /run/archiso ]] || grep -Eq '(^| )(archisobasedir|archisolabel|cow_spacesize)=' /proc/cmdline 2>/dev/null; then
  is_live=true
fi
if [[ "$is_live" != true ]]; then
  echo 'forge-live-setup detected an installed system; no live-user, passwordless sudo, or live greeter changes were applied.'
  exit 0
fi

live_user=forge
live_home=/home/forge
repo=/opt/forge-os

groups=(wheel audio video input storage)
getent group network >/dev/null 2>&1 && groups+=(network)
group_csv="$(IFS=,; echo "${groups[*]}")"
if ! id "$live_user" >/dev/null 2>&1; then
  useradd --create-home --shell /usr/bin/fish --groups "$group_csv" "$live_user"
else
  usermod --append --groups "$group_csv" --shell /usr/bin/fish "$live_user"
fi
passwd --lock "$live_user" >/dev/null

install -d -o "$live_user" -g "$live_user" -m 0700 "$live_home/.local/state/forge"
install -d -o "$live_user" -g "$live_user" -m 0755 "$live_home/.config/fish/conf.d"
install -d -o "$live_user" -g "$live_user" -m 0700 /run/forge-live-setup
if [[ -r /usr/share/forge-os/forge-dr460nized.fish ]]; then
  install -o "$live_user" -g "$live_user" -m 0644 /usr/share/forge-os/forge-dr460nized.fish "$live_home/.config/fish/conf.d/forge-dr460nized.fish"
fi
if [[ -r /opt/forge/current/resources/ollama/skills.json ]]; then
  install -d -o "$live_user" -g "$live_user" -m 0700 "$live_home/.config/ollama/skills/local-model-tooling/agents"
  install -o "$live_user" -g "$live_user" -m 0644 /opt/forge/current/resources/ollama/skills.json "$live_home/.config/ollama/skills.json"
  [[ ! -r /opt/forge/current/resources/ollama/skills/local-model-tooling/SKILL.md ]] || install -o "$live_user" -g "$live_user" -m 0644 /opt/forge/current/resources/ollama/skills/local-model-tooling/SKILL.md "$live_home/.config/ollama/skills/local-model-tooling/SKILL.md"
  [[ ! -r /opt/forge/current/resources/ollama/skills/local-model-tooling/agents/openai.yaml ]] || install -o "$live_user" -g "$live_user" -m 0644 /opt/forge/current/resources/ollama/skills/local-model-tooling/agents/openai.yaml "$live_home/.config/ollama/skills/local-model-tooling/agents/openai.yaml"
fi

install -d -o root -g root -m 0750 /etc/sudoers.d
printf '%s ALL=(ALL:ALL) NOPASSWD: ALL\n' "$live_user" >/etc/sudoers.d/10-forge-live
chmod 0440 /etc/sudoers.d/10-forge-live
visudo -cf /etc/sudoers.d/10-forge-live >/dev/null

for required in \
  "$repo/config/forge-live-greetd.toml" \
  "$repo/scripts/forge-live-install" \
  "$repo/scripts/forge-live-select-installer" \
  "$repo/scripts/forge-clean-install" \
  "$repo/scripts/forge-live-guided-install" \
  "$repo/scripts/forge-live-setup-ui" \
  "$repo/scripts/forge-service-manager" \
  "$repo/scripts/forge-service-control" \
  "$repo/scripts/forge-maintenance-center" \
  "$repo/manifests/system-services.tsv" \
  "$repo/session/forge-live-root-shell.desktop" \
  "$repo/session/forge-live-installer.desktop" \
  "$repo/session/forge-live-clean-install.desktop" \
  "$repo/session/forge-live-setup.desktop"; do
  [[ -r "$required" ]] || { echo "Live recovery payload is missing: $required" >&2; exit 1; }
done

install -o root -g root -m 0644 "$repo/config/forge-live-greetd.toml" /etc/greetd/config.toml
install -o root -g root -m 0755 "$repo/scripts/forge-live-install" /usr/local/libexec/forge-live-install
install -o root -g root -m 0755 "$repo/scripts/forge-live-select-installer" /usr/local/bin/forge-live-select-installer
install -o root -g root -m 0755 "$repo/scripts/forge-clean-install" /usr/local/bin/forge-clean-install
install -o root -g root -m 0755 "$repo/scripts/forge-live-guided-install" /usr/local/bin/forge-live-guided-install
install -o root -g root -m 0755 "$repo/scripts/forge-live-setup-ui" /usr/local/bin/forge-live-setup-ui
install -o root -g root -m 0755 "$repo/scripts/forge-service-manager" /usr/local/bin/forge-service-manager
install -o root -g root -m 0755 "$repo/scripts/forge-maintenance-center" /usr/local/bin/forge-maintenance-center
install -o root -g root -m 0755 "$repo/scripts/forge-service-control" /usr/local/libexec/forge-service-control
install -o root -g root -m 0644 "$repo/manifests/system-services.tsv" /usr/share/forge-os/system-services.tsv
install -o root -g root -m 0644 "$repo/session/forge-live-root-shell.desktop" /usr/share/applications/forge-live-root-shell.desktop
install -o root -g root -m 0644 "$repo/session/forge-live-installer.desktop" /usr/share/applications/forge-live-installer.desktop
install -o root -g root -m 0644 "$repo/session/forge-live-clean-install.desktop" /usr/share/applications/forge-live-clean-install.desktop
install -o root -g root -m 0644 "$repo/session/forge-live-setup.desktop" /usr/share/applications/forge-live-setup.desktop

for script in \
  /usr/local/libexec/forge-live-install \
  /usr/local/libexec/forge-service-control \
  /usr/local/bin/forge-live-select-installer \
  /usr/local/bin/forge-clean-install \
  /usr/local/bin/forge-live-guided-install \
  /usr/local/bin/forge-live-setup-ui \
  /usr/local/bin/forge-service-manager \
  /usr/local/bin/forge-maintenance-center; do
  bash -n "$script"
done

grep -Fq 'FORGE_LIVE_RECOVERY=1' /etc/greetd/config.toml || { echo 'Live recovery environment flag is missing from greetd.' >&2; exit 1; }
grep -Fq '/usr/local/bin/forge-wayland-session' /etc/greetd/config.toml || { echo 'Live recovery greetd does not use the installed FORGE Wayland session.' >&2; exit 1; }

echo 'FORGE live setup, guided clean installer, root recovery shell, Advanced maintenance, bundle installer, and GUI session are ready.'
