#!/usr/bin/env bash
set -euo pipefail

[[ "${FORGE_OS_SESSION:-0}" == 1 ]] || { echo 'Workspace launching is available only inside a FORGE-OS session.' >&2; exit 77; }
(( $# == 1 )) || { echo 'Usage: forge-open PATH' >&2; exit 64; }

target="$(realpath -e -- "$1")" || { echo "Path does not exist: $1" >&2; exit 66; }
workspace="$(realpath -e -- "${FORGE_WORKSPACE:-$HOME}")" || exit 66
case "$target" in
  "$workspace"|"$workspace"/*) ;;
  *) echo "Refusing to open a path outside the FORGE workspace: $target" >&2; exit 77 ;;
esac

if [[ -d "$target" ]]; then workspace_target="$target"; else workspace_target="$(dirname -- "$target")"; fi
nohup /usr/local/bin/forge-session --workspace="$workspace_target" >/dev/null 2>&1 &
disown
